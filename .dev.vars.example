# ============================================================
# Sentinel SaaS — Environment Variables
# Copy this file to .dev.vars for local Wrangler development
# NEVER commit .dev.vars to git
# ============================================================

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhb...   # Project Settings > API > service_role key

# ── Google Gemini (HealingAgent LLM) ─────────────────────
# https://aistudio.google.com/apikey
AI_API_KEY=...
# Opcional — wrangler.toml usa gemini-2.5-flash; cambia solo si tu proyecto requiere otro id (ListModels en AI Studio)
# GEMINI_MODEL=gemini-2.5-flash
# Opcional — tiempo máx. de un webhook (ms), por defecto 180000
# WEBHOOK_PROCESSING_TIMEOUT_MS=180000

# ── Upstash Redis (Rule Cache) ────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Upstash QStash (Event Queue) ──────────────────────────
# console.upstash.com → tab "QStash" → copiar las 3 vars
QSTASH_TOKEN=qstash_...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# URL pública de tu Worker (para QStash callbacks, webhooks, prefijo de rutas).
# En dev: http://localhost:8787 | En prod: https://api.tudominio.com/gateway si el API vive bajo /gateway
# Si WORKER_URL es solo el origin sin el prefijo, opcional: SENTINEL_HTTP_PATH_PREFIX=/gateway
WORKER_URL=http://localhost:8787

# Email: binding [[send_email]] en wrangler.toml (sin API key en vars).

# ── Misc ──────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
