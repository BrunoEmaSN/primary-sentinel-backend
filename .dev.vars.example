# ============================================================
# Sentinel SaaS — Environment Variables
# Copy this file to .dev.vars for local Wrangler development
# NEVER commit .dev.vars to git
# ============================================================

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhb...   # Project Settings > API > service_role key

# ── Anthropic (HealingAgent LLM) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Upstash Redis (Rule Cache) ────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Upstash QStash (Event Queue) ──────────────────────────
# console.upstash.com → tab "QStash" → copiar las 3 vars
QSTASH_TOKEN=qstash_...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# URL pública de tu Worker (para QStash callbacks)
# En dev: http://localhost:8787 | En prod: tu URL de workers.dev
WORKER_URL=http://localhost:8787

# ── Resend (Email Notifications) ─────────────────────────
RESEND_API_KEY=re_...

# ── Misc ──────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
